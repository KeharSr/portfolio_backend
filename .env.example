NODE_ENV=development
PORT=5000

# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:keharsr@localhost:5432/portfolio?schema=public"

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins, or * for all
CORS_ORIGIN=http://localhost:3000

# The first admin can always register. Set true to allow more admins.
ALLOW_REGISTRATION=false

# Used by `npm run seed` to create the admin user
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
