NODE_ENV=development
PORT=5000

# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:keharsr@localhost:5432/portfolio?schema=public"

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins, or * for all
CORS_ORIGIN=http://localhost:3000

# The first admin can always register. Set true to allow more admins.
ALLOW_REGISTRATION=false

# Used by `npm run seed` to create the admin user
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

# ---------- File uploads ----------
# Public URL of this API, used to build absolute image URLs (e.g. https://api.example.com).
# Leave empty to use the host of each request.
PUBLIC_URL=
# Folder where uploaded files are saved (served at /uploads)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
# Store uploads on Cloudinary instead of UPLOAD_DIR (required on Render's free tier,
# whose disk is wiped on every deploy). Copy "API environment variable" from the Cloudinary dashboard.
CLOUDINARY_URL=
# Folder inside your Cloudinary media library
CLOUDINARY_FOLDER=portfolio
# Set true when running behind a reverse proxy / hosting platform that terminates HTTPS
TRUST_PROXY=false
